<!--
  Recommended default Modifications for a new DAB project's FLEx-exported
  dictionary, generated by dab-entry-formatter.py's own default rule set
  (FIELD_DEFS / DEFAULT_GLOBALS / DEFAULT_SENSE_NUMBER — see CLAUDE.md for the
  geometry these numbers implement).

  This is the <styles type="single-entry"> block a fresh project would end up
  with if someone opened dab-entry-formatter.html against it and clicked
  "Save to live appDef" without changing anything. Splice it in place of the
  appDef's existing <styles type="single-entry"> block (or its self-closing
  <styles type="single-entry"/> placeholder), and turn on
  <feature name="modify-single-entry-styles" value="true"/>.

  As CLAUDE.md warns, a row here only takes effect if its selector also
  appears in that project's own Imported Styles list — check with
  dab-entry-formatter.html's Tune view (rows show red/amber if a selector
  doesn't resolve) before assuming this reproduces the intended layout for a
  given project's export.
-->
  <styles type="single-entry">
    <style name=".entry" category="text">
      <style-decl property="margin-left" value="0"/>
      <style-decl property="text-indent" value="0"/>
      <style-decl property="padding-left" value="0.3em"/>
      <style-decl property="padding-right" value="0.3em"/>
      <style-decl property="line-height" value="1.35"/>
      <style-decl property="white-space" value="normal"/>
    </style>
    <style name=".minorentryvariant" category="text">
      <style-decl property="margin-left" value="0"/>
      <style-decl property="text-indent" value="0"/>
      <style-decl property="padding-left" value="0.3em"/>
      <style-decl property="padding-right" value="0.3em"/>
      <style-decl property="line-height" value="1.35"/>
      <style-decl property="white-space" value="normal"/>
    </style>
    <style name=".minorentrycomplex" category="text">
      <style-decl property="margin-left" value="0"/>
      <style-decl property="text-indent" value="0"/>
      <style-decl property="padding-left" value="0.3em"/>
      <style-decl property="padding-right" value="0.3em"/>
      <style-decl property="line-height" value="1.35"/>
      <style-decl property="white-space" value="normal"/>
    </style>
    <style name=".senses" category="text">
      <style-decl property="display" value="block"/>
      <style-decl property="margin-left" value="0"/>
      <style-decl property="text-indent" value="0"/>
    </style>
    <style name=".senses-2" category="text">
      <style-decl property="display" value="block"/>
      <style-decl property="margin-left" value="0"/>
      <style-decl property="text-indent" value="0"/>
    </style>
    <style name=".mainheadword" category="text">
      <style-decl property="display" value="block"/>
      <style-decl property="margin-left" value="0.6em"/>
      <style-decl property="text-indent" value="-0.6em"/>
      <style-decl property="font-size" value="120%"/>
      <style-decl property="padding-bottom" value="0.15em"/>
    </style>
    <style name=".headword" category="text">
      <style-decl property="display" value="block"/>
      <style-decl property="margin-left" value="0.6em"/>
      <style-decl property="text-indent" value="-0.6em"/>
      <style-decl property="font-size" value="120%"/>
      <style-decl property="padding-bottom" value="0.15em"/>
    </style>
    <style name=".headword-5" category="text">
      <style-decl property="display" value="block"/>
      <style-decl property="margin-left" value="0.6em"/>
      <style-decl property="text-indent" value="-0.6em"/>
